# =======================================================================
# STASIS — ESP32-CAM SDK Configuration Defaults
# These values are applied when building for the first time.
# To modify at runtime: pio run -t menuconfig
# =======================================================================

# ---- CPU ----
CONFIG_ESP32_DEFAULT_CPU_FREQ_240=y

# ---- PSRAM (REQUIRED for ESP-WHO MTMN face detection) ----
CONFIG_ESP32_SPIRAM_SUPPORT=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_CACHE_WORKAROUND=y

# ---- Flash ----
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# ---- Partition Table ----
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ---- HTTP Server (for MJPEG streaming) ----
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512

# ---- WiFi ----
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n

# ---- Logging ----
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_DEFAULT_LEVEL=3

# ---- FreeRTOS ----
CONFIG_FREERTOS_HZ=1000

# ---- mbedTLS (used for Base64 encoding in UART comms) ----
CONFIG_MBEDTLS_HARDWARE_AES=y

# ---- Watchdog ----
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
