# =============================================================
# STASIS Server — Environment Configuration
# Copy this file to .env and update the values for your setup.
# =============================================================

# ---- Server ----
STASIS_HOST=0.0.0.0
STASIS_PORT=5000
STASIS_SECRET=change-me-to-a-random-string
STASIS_DEBUG=false

# ---- Database ----
STASIS_DB=/var/stasis/stasis.db

# ---- UART (to ESP32-C3) ----
STASIS_UART=/dev/ttyS0
STASIS_UART_BAUD=9600

# ---- Reports ----
STASIS_REPORTS=/var/stasis/reports
STASIS_REPORT_TIME=23:55
STASIS_SNAPSHOTS=/var/stasis/snapshots

# ---- Charging ----
STASIS_BAT_LOW=3.6
STASIS_BAT_FULL=4.2
STASIS_BAT_CRITICAL=3.3
STASIS_CHARGE_START=02:00
STASIS_CHARGE_END=06:00
STASIS_AUTO_RETURN=true

# ---- Charging Station GPS (set to your station location) ----
STASIS_STATION_LAT=0.0
STASIS_STATION_LON=0.0

# ---- Camera ----
STASIS_CAM_URL=http://192.168.4.2:81/stream
STASIS_CAM_CAPTURE=http://192.168.4.2:81/capture

# ---- GPIO (RPi BCM pin numbers) ----
STASIS_RELAY_PIN=18
STASIS_ESTOP_PIN=27

# ---- Dashboard static files ----
# STASIS_STATIC=./static
